{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  schedule: [
    'before 8am on monday',
  ],
  timezone: 'Europe/Amsterdam',
  prConcurrentLimit: 5,
  labels: [
    'dependencies',
    'renovate',
  ],
  packageRules: [
    {
      description: 'Group minor/patch pip updates across all services',
      matchManagers: [
        'pip_requirements',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'pip minor and patch updates',
    },
    {
      description: 'Major pip updates get individual PRs for careful review',
      matchManagers: [
        'pip_requirements',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'renovate',
        'breaking',
      ],
    },
    {
      description: 'Group Docker base image updates (digest and version)',
      matchManagers: [
        'dockerfile',
      ],
      groupName: 'docker base images',
    },
    {
      description: 'Docker Compose service image updates',
      matchManagers: [
        'docker-compose',
      ],
      groupName: 'docker compose images',
    },
    {
      description: 'Group chromadb pip package and Docker image into one PR',
      groupName: 'chromadb',
      matchDepNames: [
        '/^chromadb/',
      ],
    },
  ],
}
